{%- comment -%}
  "Build your own kit" block. Add it to a page template (e.g. a page called "Build your kit").
  Shoppers pick items from the chosen collection; once they hit the minimum the kit is added
  to the cart with a shared `_kit` ID, and the app's discount function applies the tier discount.
{%- endcomment -%}
{%- assign kit_config = app.metafields.kitgift.config.value.kit -%}
{%- assign source = block.settings.collection -%}

<div
  class="kitgift-kit"
  data-kitgift-kit
  data-root="{{ routes.root_url }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-after-add="{{ block.settings.after_add }}"
  data-allow-multiples="{{ block.settings.allow_multiples }}"
  data-vendor-filter="{{ block.settings.vendors | escape }}"
  data-heading-vendor="{{ block.settings.vendor_heading | escape }}"
  style="--kitgift-accent: {{ block.settings.accent }}; --kitgift-columns: {{ block.settings.columns }};"
>
  <script type="application/json" data-kitgift-kit-config>{{ kit_config | json }}</script>

  <div class="kitgift-kit__header">
    <h2 class="kitgift-kit__title" data-kitgift-title>{{ block.settings.heading | escape }}</h2>
    {%- if block.settings.subheading != blank -%}
      <p class="kitgift-kit__sub">{{ block.settings.subheading | escape }}</p>
    {%- endif -%}
    <ol class="kitgift-kit__tiers" data-kitgift-tiers></ol>
  </div>

  {%- if kit_config == blank or kit_config.enabled != true -%}
    {%- if request.design_mode -%}
      <p class="kitgift-kit__notice">Kit builder is off. Turn it on in the app under “Build your own kit”.</p>
    {%- endif -%}
  {%- elsif source == blank -%}
    {%- if request.design_mode -%}
      <p class="kitgift-kit__notice">Choose a collection for this block in the theme editor.</p>
    {%- endif -%}
  {%- else -%}
    <div class="kitgift-kit__grid">
      {%- paginate source.products by block.settings.limit -%}
        {%- for item in source.products -%}
          {%- if item.available == false -%}{%- continue -%}{%- endif -%}
          <div class="kitgift-card" data-kitgift-card data-vendor="{{ item.vendor | escape }}">
            <div class="kitgift-card__media">
              {%- if item.featured_image -%}
                {{ item.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: item.title }}
              {%- endif -%}
            </div>
            <p class="kitgift-card__vendor">{{ item.vendor | escape }}</p>
            <p class="kitgift-card__title">{{ item.title | escape }}</p>
            {%- if item.has_only_default_variant -%}
              <input type="hidden" data-kitgift-variant value="{{ item.selected_or_first_available_variant.id }}" data-price="{{ item.selected_or_first_available_variant.price }}">
              <p class="kitgift-card__price">{{ item.selected_or_first_available_variant.price | money }}</p>
            {%- else -%}
              <select class="kitgift-card__select" data-kitgift-variant aria-label="{{ item.title | escape }} options">
                {%- for variant in item.variants -%}
                  {%- if variant.available -%}
                    <option value="{{ variant.id }}" data-price="{{ variant.price }}">
                      {{ variant.title | escape }} – {{ variant.price | money }}
                    </option>
                  {%- endif -%}
                {%- endfor -%}
              </select>
            {%- endif -%}
            <div class="kitgift-card__qty">
              <button type="button" data-kitgift-minus aria-label="Remove one">−</button>
              <span data-kitgift-count>0</span>
              <button type="button" data-kitgift-plus aria-label="Add one">+</button>
            </div>
          </div>
        {%- endfor -%}
      {%- endpaginate -%}
    </div>

    <div class="kitgift-kit__bar" data-kitgift-bar>
      <div class="kitgift-kit__progress"><span data-kitgift-progress></span></div>
      <div class="kitgift-kit__bar-row">
        <div>
          <p class="kitgift-kit__status" data-kitgift-status></p>
          <p class="kitgift-kit__total" data-kitgift-total></p>
        </div>
        <button type="button" class="kitgift-kit__add" data-kitgift-add disabled>
          {{ block.settings.button_label | escape }}
        </button>
      </div>
    </div>
  {%- endif -%}
</div>

<script src="{{ 'kitgift-kit.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'kitgift.css' | asset_url }}">

{% schema %}
{
  "name": "Build your own kit",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your own kit & save" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pick your favorites — the more you add, the more you save." },
    { "type": "collection", "id": "collection", "label": "Products to choose from" },
    {
      "type": "text",
      "id": "vendors",
      "label": "Only show these vendors",
      "info": "Comma separated. Leave blank to use the vendors set in the app. A ?vendor= link (from the kit button block) also filters."
    },
    { "type": "text", "id": "vendor_heading", "label": "Heading when filtered by vendor", "info": "Use {vendor}.", "default": "Build your {vendor} kit & save" },
    { "type": "range", "id": "limit", "label": "Max products", "min": 10, "max": 250, "step": 10, "default": 50 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "allow_multiples", "label": "Allow more than one of the same item", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add kit to cart" },
    {
      "type": "select",
      "id": "after_add",
      "label": "After adding the kit",
      "options": [
        { "value": "cart", "label": "Go to cart" },
        { "value": "checkout", "label": "Go to checkout" },
        { "value": "stay", "label": "Stay on page" }
      ],
      "default": "cart"
    },
    { "type": "color", "id": "accent", "label": "Accent color", "default": "#111111" }
  ]
}
{% endschema %}
