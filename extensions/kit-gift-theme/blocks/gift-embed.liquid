{%- comment -%}
  App embed: when the cart qualifies for a free gift, shows a "Choose your free gift" box at the
  bottom of the cart drawer and on the cart page. Enable it under Online Store > Themes > Customize > App embeds.
{%- endcomment -%}
{%- assign kitgift_config = app.metafields.kitgift.config.value -%}
<script type="application/json" id="kitgift-config">{{ kitgift_config | json }}</script>
<script type="application/json" id="kitgift-settings">
  {
    "root": {{ routes.root_url | json }},
    "moneyFormat": {{ shop.money_format | json }},
    "heading": {{ block.settings.heading | json }},
    "headingSingle": {{ block.settings.heading_single | json }},
    "subheading": {{ block.settings.subheading | json }},
    "addLabel": {{ block.settings.add_label | json }}
  }
</script>
<style>
  :root {
    --kitgift-accent: {{ block.settings.accent }};
  }
</style>

{% schema %}
{
  "name": "Free gift in cart",
  "target": "body",
  "javascript": "kitgift-gift.js",
  "stylesheet": "kitgift.css",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (several gifts to choose from)",
      "default": "🎁 Choose your free gift"
    },
    {
      "type": "text",
      "id": "heading_single",
      "label": "Heading (one gift)",
      "default": "🎁 You get a free gift"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Included with your order"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Button label",
      "default": "Add free"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent color",
      "default": "#111111"
    }
  ]
}
{% endschema %}
